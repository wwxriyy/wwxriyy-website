[Unit]
Description=wwxriyy bio Django site
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/wwxriyy-bio
EnvironmentFile=/var/www/wwxriyy-bio/.env
ExecStart=/var/www/wwxriyy-bio/.venv/bin/gunicorn bio_site.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
